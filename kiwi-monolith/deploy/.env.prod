# Production Environment Configuration
# Copy to .env and modify with your production values
# IMPORTANT: Never commit this file with real credentials!

# ===== Database =====
DB_HOST=kiwi-mysql
DB_PORT=3306
DB_NAME=kiwi_db
DB_USERNAME=root
DB_PASSWORD=your_secure_password

# ===== Redis =====
REDIS_HOST=kiwi-redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_password

# ===== Elasticsearch =====
ES_URIS=http://kiwi-elasticsearch:9200
ES_USERNAME=elastic
ES_PASSWORD=your_secure_password

# ===== FastDFS =====
FASTDFS_TRACKER=kiwi-fastdfs:22122

# ===== Application =====
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ===== Encryption =====
KIWI_ENC_PASSWORD=your_secure_encryption_password

# ===== Timezone =====
TZ=Pacific/Auckland

# ===== AI Services =====
# GROK_API_KEY=
# YTB_API_KEY=
# YTB_PROXY_VALUE=
# DEEPGRAM_API_KEY=

# ===== Google Cloud =====
# GCP_PROJECT_ID=
# GCP_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=

# ===== OAuth2 =====
# GOOGLE_OAUTH2_CLIENT_ID=
# GOOGLE_OAUTH2_CLIENT_SECRET=
# GOOGLE_OAUTH2_REDIRECT_URI=
# HOME_PAGE=

# ===== JVM Options (for run.sh) =====
JVM_OPTS="-Xms512m -Xmx1g -XX:+UseG1GC"
