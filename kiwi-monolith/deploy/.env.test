# Test/Staging Environment Configuration
# Copy to .env and modify as needed

# ===== Database =====
DB_HOST=kiwi-mysql
DB_PORT=3306
DB_NAME=kiwi_db_test
DB_USERNAME=root
DB_PASSWORD=your_test_password

# ===== Redis =====
REDIS_HOST=kiwi-redis
REDIS_PORT=6379
REDIS_PASSWORD=your_test_password
REDIS_DATABASE=1

# ===== Elasticsearch =====
ES_URIS=http://kiwi-elasticsearch:9200
ES_USERNAME=elastic
ES_PASSWORD=your_test_password

# ===== FastDFS =====
FASTDFS_TRACKER=kiwi-fastdfs:22122

# ===== Application =====
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=8080

# ===== Encryption =====
KIWI_ENC_PASSWORD=your_encryption_password

# ===== Timezone =====
TZ=Pacific/Auckland

# ===== AI Services =====
# GROK_API_KEY=
# YTB_API_KEY=
# DEEPGRAM_API_KEY=

# ===== Google Cloud =====
# GCP_PROJECT_ID=
# GCP_BUCKET=kiwidict-bucket-test
# GOOGLE_APPLICATION_CREDENTIALS=

# ===== OAuth2 =====
# GOOGLE_OAUTH2_CLIENT_ID=
# GOOGLE_OAUTH2_CLIENT_SECRET=
# GOOGLE_OAUTH2_REDIRECT_URI=
# HOME_PAGE=
