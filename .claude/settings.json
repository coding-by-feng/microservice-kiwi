{
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "mysql",
    "redis",
    "filesystem",
    "git",
    "fetch"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "aplay -q /usr/share/sounds/freedesktop/stereo/dialog-warning.oga 2>/dev/null || paplay /usr/share/sounds/freedesktop/stereo/dialog-warning.oga 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Bash command needs approval' 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aplay -q /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null || paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Claude done ✅' 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}