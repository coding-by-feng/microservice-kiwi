{
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "mysql",
    "redis",
    "filesystem",
    "git",
    "fetch"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          },
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Bash command needs approval\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Purr.aiff"
          },
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude done ✅\" with title \"Claude Code\"'"
          }
        ]
      }
    ]
  }
}